# ---------------------------------------------------------------------------
# Edge AI Router — environment
#
# Copy to `.env` for local dev (`cp .env.example .env`). On Vercel, set these in
# Project Settings -> Environment Variables.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION.
# Encrypts the `er1.` master key that carries a user's raw provider keys.
# There is deliberately NO fallback value: if this is missing while
# NODE_ENV=production (or on Vercel), /api/keys/* refuses to run and returns a
# 500 explaining why. A published default secret would let anyone reading this
# public repo decrypt any user's token and recover every provider key inside.
#
# Generate one with:  openssl rand -hex 32
# Minimum length enforced: 16 characters. Rotating it invalidates existing tokens.
MASTER_KEY_SECRET=""

# Optional. Server-side fallback key for the in-app Copilot when a user has not
# supplied their own. Google AI Studio injects this automatically from Secrets.
# Inference through the gateways never uses it — those are strictly BYO-key.
GEMINI_API_KEY=""

# Optional. Canonical public URL of this deployment, used for the `HTTP-Referer`
# attribution header some upstreams (OpenRouter) expect. When unset it is derived
# from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL, then from the request origin.
# AI Studio injects the Cloud Run service URL here automatically.
APP_URL=""

# Optional. Vercel KV (Upstash Redis) REST credentials, used ONLY to make master
# key revocation authoritative. Without them the app degrades gracefully:
# revoke wipes the local copy and returns { revoked: false, mode: "local-only" },
# and the revocation check fails OPEN so a KV outage never blocks inference.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""
